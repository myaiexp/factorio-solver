#!/usr/bin/env bash
# Refuse to publish a tree that does not build, test, and lint clean.
#
# pre-commit is the primary gate; this is the one that closes its two holes:
#
#   * a merge commit never runs pre-commit (git runs pre-merge-commit, and for
#     a conflicted merge the resolution is the only thing checked). `deploy`
#     merges the worktree branch onto master, so the tree that actually reaches
#     origin is one no pre-commit ever saw.
#   * `--no-verify` exists, and work-in-progress commits use it.
#
# Push is the last boundary before other machines pull this, so it is the right
# place for the backstop.
#
# What can be verified: only the working tree, since building an arbitrary
# pushed commit would need a temp checkout and a cold cargo cache (minutes, on
# every push). So the check runs when the tree is clean and HEAD is among the
# commits being pushed — which is exactly the `deploy` path, as deploy refuses
# a dirty tree itself. Anything else is reported as unverified rather than
# quietly waved through.
#
# Bypass with `git push --no-verify`.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

head=$(git rev-parse HEAD)
zero='0000000000000000000000000000000000000000'

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
pushing_head=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue  # a branch deletion pushes nothing
  [[ "$local_sha" == "$head" ]] && pushing_head=1
done

if ((!pushing_head)); then
  echo "gate: pushing a commit that is not HEAD — not verified." >&2
  echo "      Check it out and re-push if you want the gate to see it." >&2
  exit 0
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "gate: working tree is dirty, so it is not the tree being pushed — not verified." >&2
  exit 0
fi

# The tree is clean at HEAD, so HEAD's sha identifies exactly what was checked.
# deploy pushes to every remote in turn and the hook fires once per remote;
# without this the same 5s of clippy+tests would run for each.
stamp="target/.gate-verified"
if [[ -f "$stamp" && "$(cat "$stamp" 2>/dev/null)" == "$head" ]]; then
  echo "gate: ok (already verified $head)"
  exit 0
fi

"$(dirname "$0")/check-workspace.sh" || exit 1
mkdir -p "$(dirname "$stamp")" && printf '%s' "$head" >"$stamp"
