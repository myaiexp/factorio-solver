#!/usr/bin/env bash
# Report whether the tree being published was ever gated. Never builds.
#
# This hook deliberately does no work. `deploy` wraps its push in
# `timeout 15` (PUSH_TIMEOUT, raised only for repos using the forgejo deploy
# marker — this one does not), and a cold `cargo clippy --workspace` in the
# main checkout is minutes. An earlier version of this hook ran the full gate
# here and killed a real deploy: the branch landed on master and the push never
# happened. Building inside a 15-second budget is not a thing that can be made
# to work, so the checking lives in pre-commit and pre-merge-commit, which have
# no such budget.
#
# What is left is a lookup, which costs nothing and still catches the one path
# no git hook covers: `deploy-land` replays a single commit onto a moved base
# with `git cherry-pick`, and cherry-pick fires no hook at all — not
# pre-commit, not pre-merge-commit (measured, not assumed). The resulting tree
# is therefore unverified, and this says so out loud rather than letting it
# leave silently. It warns instead of refusing, because refusing would turn
# every such land into a manual push for a tree that is usually fine.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1
. "$(dirname "$0")/stamp.sh"

head=$(git rev-parse HEAD)
zero='0000000000000000000000000000000000000000'

# stdin: <local ref> <local sha> <remote ref> <remote sha>, one line per ref.
pushing_head=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch deletion pushes nothing
  [ "$local_sha" = "$head" ] && pushing_head=1
done

if [ "$pushing_head" -eq 0 ]; then
  echo "gate: pushing something that is not HEAD — cannot say whether it was verified." >&2
  exit 0
fi

tree=$(git rev-parse "HEAD^{tree}")
if tree_is_verified "$tree"; then
  echo "gate: ok (verified tree $tree)"
  exit 0
fi

echo "gate: WARNING — this tree was never gated, pushing anyway." >&2
echo "      Most likely a cherry-pick land, which fires no git hook." >&2
echo "      Check it with scripts/hooks/check-workspace.sh." >&2
exit 0
